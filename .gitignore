# Dependencies and local package caches
node_modules/
.npm/
.pnpm-store/
.cache/

# Generated browser / whiteboard bundles and npm package archives
/dist/
*.tgz

# Test, coverage, and browser automation output
/coverage/
.nyc_output/
*.lcov
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Logs, process files, and Node diagnostic reports
*.log
*.pid
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.json
.node_repl_history

# Local environment files; sanitized examples can be committed
.env
.env.*
!.env.example
!.env.*.example

# Local Planboard daemon / state root (when configured inside the repository)
.planboard/

# Machine-local board data, including sidecars that have not written .gitignore yet
# Keep notes.json, events.jsonl, snapshot.json, and attachments versioned with plans.
**/*.board/visits.json
**/*.board/whiteboards/
**/*.board/workflow/writer.lock
**/*.board/workflow/writer.guard
**/*.board/workflow/snapshot.json
**/*.board/workflow/journal.jsonl

# Atomic-write leftovers and local scratch directories
*.tmp
/tmp/
/temp/

# Personal agent settings; shared skills, rules, and project instructions stay trackable
.claude/settings.local.json
CLAUDE.local.md

# Editor and operating-system files
.idea/
.history/
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini
